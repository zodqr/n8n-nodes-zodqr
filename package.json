{
  "name": "n8n-nodes-zodqr",
  "version": "0.1.0",
  "description": "Custom node to integrate with ZodQR",
  "license": "MIT",
  "homepage": "https://zodqr.com",
  "keywords": ["n8n-community-node-package"],
  "author": { "name": "Huong Pham", "email": "huong.px01@gmail.com" },
  "repository": {
    "type": "git",
    "url": "https://github.com/zodqr/n8n-nodes-zodqr.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/zodqrOAuth2Api.credentials.js"],
    "nodes": ["dist/nodes/ZodQR/ZodQR.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
